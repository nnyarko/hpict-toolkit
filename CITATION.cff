repository-code: "https://github.com/nnyarko/hpict-toolkit"
keywords:
  - healthcare
  - FWA prevention
  - fraud prevention
  - program integrity
  - internal controls
  - COSO
  - GAO Green Book
  - Medicare
  - Medicaid
  - fraud waste and abuse
  - control self-assessment
# CONCEPT DOI: deliberately not a version DOI. Zenodo mints one DOI per version
# (v1.0.0 is 10.5281/zenodo.22003348) plus one that always resolves to the newest
# release. Using the concept DOI means this line never has to be touched again and
# no citation can be left pointing at a superseded version. Verified 2026-08-24:
# 10.5281/zenodo.22003347 redirects to the current record.
doi: 10.5281/zenodo.22003347
